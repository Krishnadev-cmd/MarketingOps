# ---------------------------------------------------------------------------
# Marketing Operations Console backend. Copy to backend/.env and fill it in.
# ---------------------------------------------------------------------------

# development = forgiving.  production = refuses to start with unsafe settings
# (missing JWT secret, demo users on, SQLite, localhost CORS).
APP_ENV=development

# MySQL 8 (required). Create the database once:
#   CREATE DATABASE marketing_ops CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# then build the tables:   .venv/Scripts/python -m alembic upgrade head
# Format: mysql+pymysql://USER:PASSWORD@HOST:3306/marketing_ops?charset=utf8mb4
# (URL-encode special characters in the password, e.g. @ becomes %40.)
# Give the app user only: SELECT, INSERT, UPDATE, DELETE on marketing_ops.*
# The user that runs migrations also needs CREATE, ALTER, INDEX, DROP, REFERENCES, TRIGGER.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/marketing_ops?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Signs login tokens. Required in production (32+ random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=12

# Wrong passwords in a row before the account locks, and for how long.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Local demo only: creates one person per role, all with DEMO_PASSWORD.
# Must be false in production (the API refuses to start otherwise).
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# --- AI drafting (Groq) -------------------------------------------------------
# Create a Groq API key at https://console.groq.com/keys and keep it only in backend/.env.
# LLM_ENABLED=false makes the studio use channel templates instead.
LLM_ENABLED=true


# Public sign-up creates Creator accounts. Set false to allow admin-created accounts only.
REGISTRATION_ENABLED=true

# --- LinkedIn ------------------------------------------------------------------
# From your app at https://www.linkedin.com/developers/apps (Auth tab). With these set,
# an admin clicks "Connect LinkedIn" on the Team page; the token LinkedIn returns is
# stored encrypted in the database, never in this file. Empty = copy and post by hand.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match an "Authorized redirect URL" in the app's Auth tab exactly.
LINKEDIN_REDIRECT_URI=http://localhost:8787/api/channels/linkedin/callback
# YYYYMM. LinkedIn supports each version for about a year; keep it recent.
LINKEDIN_API_VERSION=202607
# Company Page (urn:li:organization:NNN). Set it ONLY after LinkedIn approves your app
# for the Community Management API, then reconnect. Until then posts go to the
# connected person's profile. (Asking for an unapproved scope makes LinkedIn refuse sign-in.)
LINKEDIN_ORGANIZATION_URN=

# Where the browser returns after connecting a channel.
FRONTEND_URL=http://localhost:3000

# Encrypts channel tokens in the database. Required in production. Generate once and keep it
# safe (changing it means reconnecting LinkedIn):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Live post watch --------------------------------------------------------------
# After publishing, the console re-reads the live post every WATCH_INTERVAL_HOURS for
# WATCH_DAYS and alerts compliance if it no longer says what was approved.
# Website pages are fetched ONLY from these hosts (and their subdomains). Empty = pages
# are not checked. Example: WATCH_ALLOWED_HOSTS=["meridianwealth.com"]
WATCH_ALLOWED_HOSTS=[]
WATCH_INTERVAL_HOURS=6
WATCH_DAYS=30

# --- Other channels ----------------------------------------------------------------
# Website: your CMS endpoint that accepts {component, title, body, media_url}.
CMS_WEBHOOK_URL=

# The publish scheduler. Safe in every API process (jobs are claimed atomically).
SCHEDULER_ENABLED=true
SCHEDULER_SECONDS=30

# Your frontend's exact URL(s). In production: https only, no localhost.
CORS_ORIGINS=["http://localhost:3000"]
